{
  "schema": "ai-employee/1",
  "slug": "jm-chief-of-staff",
  "name": "Chief of Staff",
  "role": "Chief of Staff",
  "version": "1.0.0",
  "standard": "1.5",
  "repository": "https://github.com/bencoll352/AI-Employee",
  "license": "UNLICENSED",
  "requires": {
    "node": ">=24.19.0",
    "harness": [
      "antigravity",
      "claude-code",
      "codex",
      "openclaw"
    ]
  },
  "governance": {
    "readOnlyByDefault": true,
    "outboundRequiresApproval": true,
    "solicitorCheckTopics": [
      "money",
      "arrears",
      "legal_notice",
      "eviction",
      "deposit",
      "tenancy_wording",
      "head_lease"
    ],
    "requireCitations": true,
    "refuseOnMissingData": true,
    "killSwitchFile": "PAUSED"
  },
  "limits": {
    "maxSteps": 8,
    "maxDelegation": 2,
    "maxDepth": 1,
    "maxTokensPerRun": 12000,
    "maxCostPerRunGbp": 0.5,
    "maxDailySpendGbp": 1.5
  },
  "allowedTools": {
    "read": [
      "knowledge.search",
      "overdue_rent",
      "expiring_certificates",
      "open_tickets",
      "void_rooms",
      "pipeline_summary",
      "property_pnl"
    ],
    "draft": [
      "deliverable.write",
      "create_draft_message"
    ]
  },
  "connections": [
    {
      "capability": "supabase.rpc.read",
      "providers": [
        "jm-letvest-supabase-rls"
      ],
      "required": true,
      "readonly": true
    },
    {
      "capability": "approval.queue.draft",
      "providers": [
        "ai-employee-sqlite"
      ],
      "required": true,
      "readonly": false
    }
  ],
  "routines": [
    {
      "id": "jm-daily-briefing",
      "days": "off",
      "target_days": "mon-sun",
      "timezone": "Europe/London",
      "fire": "07:30",
      "window_start": "07:15",
      "window_end": "10:30",
      "period_key": "YYYY-MM-DD",
      "budget": "10 min",
      "browser": "never"
    },
    {
      "id": "jm-friday-scoreboard",
      "days": "off",
      "target_days": "fri",
      "timezone": "Europe/London",
      "fire": "16:00",
      "window_start": "15:45",
      "window_end": "19:00",
      "period_key": "YYYY-Www",
      "budget": "15 min",
      "browser": "never"
    }
  ],
  "files": {
    "kit": [
      "ROLE.md",
      "employee.json",
      "routines/**",
      "examples/**"
    ],
    "merge": [
      "../SCHEDULE.md"
    ],
    "member": [
      "../../PAUSED",
      "../../state/**"
    ]
  }
}
